  "texopt_requirement_map": {
    "note": "font_pt 取正文 10pt；margin_mm 取左右边距 0.8125in=20.64mm（决定版心宽 174.6mm），上下边距更大（25.4/28.6mm）",
    "requirement_fields": {
      "page_limit": 8,
      "font_pt": 10,
      "margin_mm": 20.64,
      "float_spec": "tbp",
      "overwide_fig_threshold_mm": 174.6,
      "margin_min_mm": 20.6
    },
    "unsupported_constraints": [
      {
        "key": "paper_size",
        "value": "letter",
        "why": "Requirement 无纸张尺寸字段"
      },
      {
        "key": "columns",
        "value": 2,
        "why": "Requirement 无栏数字段"
      },
      {
        "key": "margins_mm",
        "value": {
          "top": 25.4,
          "bottom": 28.6,
          "left": 20.6,
          "right": 20.6
        },
        "why": "Requirement.margin_mm 是单一值，无法表达上下/左右不等"
      },
      {
        "key": "page_limit_content",
        "value": 8,
        "why": "page_limit 语义为总页数；CVPR 的 8 页只算正文，参考文献另计"
      },
      {
        "key": "appendix_allowed",
        "value": false,
        "why": "texopt 无“正文禁附录”这类结构约束"
      },
      {
        "key": "anonymity",
        "value": "double-blind",
        "why": "texopt 不处理匿名化"
      }
    ],
    "recommended_field_suggestions": [
      {
        "field": "columns",
        "type": "int",
        "example": 2,
        "rationale": "校验编译结果栏数是否为双栏"
      },
      {
        "field": "page_limit_scope",
        "type": "str",
        "example": "content_only",
        "rationale": "区分正文页与总页；否则 8 页约束会把参考文献算进去"
      },
      {
        "field": "asymmetric_margins",
        "type": "obj",
        "example": {
          "left": 20.6,
          "right": 20.6,
          "top": 25.4,
          "bottom": 28.6
        },
        "rationale": "CVPR 上下边距大于左右，单一 margin_mm 会失真"
      },
      {
        "field": "caption_position_policy",
        "type": "obj",
        "example": {
          "figure": "below",
          "table": "above"
        },
        "rationale": "图题在下/表题在上是官方模板明文，可作 A 项检查"
      }
    ]
  },

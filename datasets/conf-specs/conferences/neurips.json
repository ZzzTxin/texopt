  "texopt_requirement_map": {
    "note": "font_pt 取官方正文 10pt；margin_mm 取等效单边边距 25.4mm（上下 1in；左右 1.5in 更大，texopt 压缩时以下限 margin_min_mm 约束，避免压到不合规）",
    "requirement_fields": {
      "page_limit": 9,
      "font_pt": 10,
      "margin_mm": 25.4,
      "float_spec": "tbp",
      "overwide_fig_threshold_mm": 139.7
    },
    "unsupported_constraints": [
      {
        "key": "paper_size",
        "value": "letter",
        "why": "Requirement 无纸张尺寸字段；texopt 不更换纸张"
      },
      {
        "key": "columns",
        "value": 1,
        "why": "Requirement 无栏数字段；仅用于校验/迁移判断"
      },
      {
        "key": "margins_mm",
        "value": {
          "top": 25.4,
          "bottom": 25.4,
          "left": 38.1,
          "right": 38.1
        },
        "why": "Requirement.margin_mm 是单一等效值，无法表达非对称边距"
      },
      {
        "key": "page_limit_content",
        "value": 9,
        "why": "page_limit 语义为“总页数”，NeurIPS 的 9 页仅指 content pages（参考文献/附录另计），需 requirements 层支持“计数范围”"
      },
      {
        "key": "checklist_required",
        "value": true,
        "why": "texopt 不生成/校验 checklist"
      }
    ],
    "recommended_field_suggestions": [
      {
        "field": "columns",
        "type": "int",
        "example": 1,
        "rationale": "校验编译结果栏数是否与官方模板一致（模板被误改时会破坏合规）"
      },
      {
        "field": "page_limit_scope",
        "type": "str",
        "example": "content_only",
        "rationale": "区分“正文页数”与“总页数”，否则 9 页约束会把参考文献页算进去导致过度压缩"
      },
      {
        "field": "asymmetric_margins",
        "type": "obj",
        "example": {
          "left": 38.1,
          "right": 38.1,
          "top": 25.4,
          "bottom": 25.4
        },
        "rationale": "NeurIPS/ICLR 等左右边距远大于上下，用单一 margin_mm 会失真"
      },
      {
        "field": "caption_position_policy",
        "type": "obj",
        "example": {
          "figure": "below",
          "table": "above"
        },
        "rationale": "图题在下/表题在上是官方推荐，可作 A 项检查"
      }
    ]
  },

  "texopt_requirement_map": {
    "note": "SOSP 与 OSDI/NSDI 共用 12 页 / 双栏 / 10pt / 7x9in 版心规格，但官方模板为 ACM SIGPLAN acmart（非 USENIX sty）。font_pt=10；margin_mm 取等效单边 19.05mm（letter 下 7in 版心；A4 下约 16mm，取较严的 19.05mm）",
    "requirement_fields": {
      "page_limit": 12,
      "font_pt": 10,
      "margin_mm": 19.05,
      "overwide_fig_threshold_mm": 178.0
    },
    "unsupported_constraints": [
      {
        "key": "paper_size",
        "value": "a4 or letter",
        "why": "Requirement 无纸张尺寸字段，且 SOSP 允许二选一"
      },
      {
        "key": "columns",
        "value": 2,
        "why": "Requirement 无栏数字段"
      },
      {
        "key": "margins_mm",
        "value": {
          "top": 25.4,
          "bottom": 25.4,
          "left": 19.05,
          "right": 19.05
        },
        "why": "单一 margin_mm 无法表达非对称边距；且 A4/letter 下不同"
      },
      {
        "key": "page_limit_content",
        "value": 12,
        "why": "语义为技术内容页数（参考文献另计），需'计数范围'支持"
      },
      {
        "key": "page_numbering",
        "value": "numbered",
        "why": "texopt 不控制页码"
      },
      {
        "key": "body_font_family",
        "value": "Times Roman / Linux Libertine",
        "why": "Requirement 无字体族字段"
      }
    ],
    "recommended_field_suggestions": [
      {
        "field": "columns",
        "type": "int",
        "example": 2,
        "rationale": "校验栏数"
      },
      {
        "field": "allowed_paper_sizes",
        "type": "list",
        "example": [
          "a4",
          "letter"
        ],
        "rationale": "部分会议允许两种纸张"
      }
    ]
  },

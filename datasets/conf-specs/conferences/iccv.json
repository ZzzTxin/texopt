  "texopt_requirement_map": {
    "note": "与 CVPR 同源（iccv.sty 由 cvpr.sty 派生）；font_pt 取正文 10pt，margin_mm 取左右 20.64mm",
    "requirement_fields": {
      "page_limit": 8,
      "font_pt": 10,
      "margin_mm": 20.64,
      "float_spec": "tbp",
      "overwide_fig_threshold_mm": 174.6,
      "margin_min_mm": 20.6
    },
    "unsupported_constraints": [
      {
        "key": "paper_size",
        "value": "letter",
        "why": "Requirement 无纸张尺寸字段"
      },
      {
        "key": "columns",
        "value": 2,
        "why": "Requirement 无栏数字段"
      },
      {
        "key": "margins_mm",
        "value": {
          "top": 25.4,
          "bottom": 28.6,
          "left": 20.6,
          "right": 20.6
        },
        "why": "单一 margin_mm 无法表达非对称边距"
      },
      {
        "key": "page_limit_content",
        "value": 8,
        "why": "8 页仅指正文，参考文献另计"
      },
      {
        "key": "appendix_allowed",
        "value": false,
        "why": "texopt 无“正文禁附录”结构约束"
      },
      {
        "key": "anonymity",
        "value": "double-blind",
        "why": "texopt 不处理匿名化"
      }
    ],
    "recommended_field_suggestions": [
      {
        "field": "columns",
        "type": "int",
        "example": 2,
        "rationale": "校验双栏"
      },
      {
        "field": "page_limit_scope",
        "type": "str",
        "example": "content_only",
        "rationale": "区分正文页与总页"
      },
      {
        "field": "asymmetric_margins",
        "type": "obj",
        "example": {
          "left": 20.6,
          "right": 20.6,
          "top": 25.4,
          "bottom": 28.6
        },
        "rationale": "下边距大于上/左右会失真"
      },
      {
        "field": "caption_position_policy",
        "type": "obj",
        "example": {
          "figure": "below",
          "table": "above"
        },
        "rationale": "官方模板明文"
      }
    ]
  },

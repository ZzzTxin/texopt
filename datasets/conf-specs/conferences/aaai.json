  "texopt_requirement_map": {
    "note": "AAAI 双栏；font_pt 取官方正文 10pt；margin_mm 取等效单边最小边距 19.05mm（左右与上 .75in；下边距 1.25in 更大，压缩时以下限约束）",
    "requirement_fields": {
      "page_limit": 7,
      "font_pt": 10,
      "margin_mm": 19.05,
      "float_spec": "tb",
      "overwide_fig_threshold_mm": 177.8
    },
    "unsupported_constraints": [
      {
        "key": "paper_size",
        "value": "letter",
        "why": "Requirement 无纸张尺寸字段"
      },
      {
        "key": "columns",
        "value": 2,
        "why": "Requirement 无栏数字段；AAAI 双栏"
      },
      {
        "key": "margins_mm",
        "value": {
          "top": 19.05,
          "bottom": 31.75,
          "left": 19.05,
          "right": 19.05
        },
        "why": "Requirement.margin_mm 单一值无法表达非对称边距（下边距 1.25in）"
      },
      {
        "key": "page_limit_content",
        "value": 7,
        "why": "page_limit 为总页数语义；AAAI 的 7 页仅指技术内容（参考文献另计）"
      },
      {
        "key": "checklist_required",
        "value": true,
        "why": "texopt 不生成/校验 reproducibility checklist"
      },
      {
        "key": "page_numbering",
        "value": "none",
        "why": "AAAI 禁止页码/页眉页脚与 \\pagestyle，texopt 无对应开关"
      },
      {
        "key": "columns_forbidden_packages",
        "value": "hyperref/geometry/etc.",
        "why": "AAAI 明令禁止若干宏包，texopt 无黑名单校验"
      }
    ],
    "recommended_field_suggestions": [
      {
        "field": "columns",
        "type": "int",
        "example": 2,
        "rationale": "校验编译结果栏数是否与官方双栏模板一致"
      },
      {
        "field": "page_limit_scope",
        "type": "str",
        "example": "content_only",
        "rationale": "区分技术内容页数与总页数"
      },
      {
        "field": "asymmetric_margins",
        "type": "obj",
        "example": {
          "left": 19.05,
          "right": 19.05,
          "top": 19.05,
          "bottom": 31.75
        },
        "rationale": "AAAI 下边距(1.25in)明显大于其它三边(.75in)"
      },
      {
        "field": "caption_position_policy",
        "type": "obj",
        "example": {
          "figure": "below",
          "table": "below"
        },
        "rationale": "AAAI 图题与表题均在下方，可作检查项"
      }
    ]
  },

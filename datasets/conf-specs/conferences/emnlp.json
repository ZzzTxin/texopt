  "texopt_requirement_map": {
    "note": "EMNLP 与 ACL 共用 *ACL 版式：font_pt 11pt、margin 25mm、版心总宽 160mm",
    "requirement_fields": {
      "page_limit": 8,
      "font_pt": 11,
      "margin_mm": 25.0,
      "float_spec": "tbp",
      "overwide_fig_threshold_mm": 160.0
    },
    "unsupported_constraints": [
      {
        "key": "paper_size",
        "value": "a4",
        "why": "Requirement 无纸张尺寸字段"
      },
      {
        "key": "columns",
        "value": 2,
        "why": "Requirement 无栏数字段"
      },
      {
        "key": "page_limit_content",
        "value": 8,
        "why": "page_limit 语义为总页数，EMNLP 的 8 页仅指正文"
      },
      {
        "key": "references_counted",
        "value": false,
        "why": "无法表达「参考文献不计页」"
      },
      {
        "key": "checklist_required",
        "value": true,
        "why": "texopt 不生成/校验 checklist"
      }
    ],
    "recommended_field_suggestions": [
      {
        "field": "columns",
        "type": "int",
        "example": 2,
        "rationale": "校验编译栏数是否与官方模板一致"
      },
      {
        "field": "page_limit_scope",
        "type": "str",
        "example": "content_only",
        "rationale": "区分正文页与总页"
      }
    ]
  },

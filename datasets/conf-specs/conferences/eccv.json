    "figure_caption_position": {
      "value": "below",
      "unit": null,
      "scope": "both",
      "confidence": "official",
      "note": "图题在图下方（与表题相反）",
      "evidence": [
        {
          "source_id": "src-eccv-lncs-instructions",
          "quote": "in contrast to the caption belonging to a table, which should always appear above the table."

  "texopt_requirement_map": {
    "note": "font_pt 取正文 10pt；margin_mm 取送审版等效单边 12mm（版心 122mm）；单栏",
    "requirement_fields": {
      "page_limit": 14,
      "font_pt": 10,
      "margin_mm": 12,
      "float_spec": "tbp",
      "overwide_fig_threshold_mm": 122.0,
      "margin_min_mm": 12
    },
    "unsupported_constraints": [
      {
        "key": "paper_size",
        "value": "146x217mm (review crop)",
        "why": "Requirement 无纸张尺寸字段；ECCV 送审版尺寸非 letter/A4"
      },
      {
        "key": "columns",
        "value": 1,
        "why": "Requirement 无栏数字段"
      },
      {
        "key": "bib_style",
        "value": "splncs04",
        "why": "texopt 不校验参考文献样式"
      },
      {
        "key": "appendix_allowed",
        "value": false,
        "why": "texopt 无“正文禁附录”结构约束"
      },
      {
        "key": "anonymity",
        "value": "double-blind",
        "why": "texopt 不处理匿名化"
      }
    ],
    "recommended_field_suggestions": [
      {
        "field": "columns",
        "type": "int",
        "example": 1,
        "rationale": "ECCV 单栏，与 CVPR/ICCV 双栏不同，需按会议区分"
      },
      {
        "field": "page_limit_scope",
        "type": "str",
        "example": "content_only",
        "rationale": "14 页仅指正文，参考文献另计"
      },
      {
        "field": "caption_position_policy",
        "type": "obj",
        "example": {
          "figure": "below",
          "table": "above"
        },
        "rationale": "Springer LNCS 明文规定"
      }
    ]
  },

{
  "schema_version": "1.0",
  "id": "eccv",
  "name": "European Conference on Computer Vision",
  "abbr": "ECCV",
  "family": "cv",
  "official_site": "https://eccv.ecva.net/",
  "current_edition": "ECCV 2026",
  "focus_editions": [
    "2022",
    "2024",
    "2026"
  ],
  "template_basis": {
    "class": "eccv.sty (based on llncs.cls)",
    "inherits": "llncs",
    "url": "https://github.com/paolo-favaro/paper-template"
  },
  "hard_constraints": {
    "page_limit_content": {
      "value": 14,
      "unit": "pages",
      "scope": "submission",
      "confidence": "official",
      "note": "正文（含全部图、表）上限 14 页；仅含参考文献的额外页不计入",
      "evidence": [
        {
          "source_id": "src-eccv-2026-submissionpolicies",
          "quote": "Papers are limited to 14 pages, including figures and tables, in the LNCS style of Springer. Additional pages containing only cited references are allowed."
        }
      ]
    },
    "references_counted": {
      "value": false,
      "unit": null,
      "scope": "submission",
      "confidence": "official",
      "note": "参考文献不计入 14 页正文",
      "evidence": [
        {
          "source_id": "src-eccv-2026-maintex",
          "quote": "Papers accepted for the conference will be allocated 14 pages (plus additional pages for references) in the proceedings."
        }
      ]
    },
    "appendix_allowed": {
      "value": false,
      "unit": null,
      "scope": "submission",
      "confidence": "official",
      "note": "主文不允许附录；附录/证明内容须放入补充材料",
      "evidence": [
        {
          "source_id": "src-eccv-2026-submissionpolicies",
          "quote": "Note that no Appendices are permitted in the main submission."
        }
      ]
    },
    "camera_ready_extra_pages": {
      "value": 0,
      "unit": "pages",
      "scope": "camera_ready",
      "confidence": "official",
      "note": "录用后仍为 14 页 + 参考文献（proceedings 分配 14 页，参考文献另计），无额外加页",
      "evidence": [
        {
          "source_id": "src-eccv-2026-maintex",
          "quote": "Papers accepted for the conference will be allocated 14 pages (plus additional pages for references) in the proceedings."
        }
      ]
    },
    "columns": {
      "value": 1,
      "unit": null,
      "scope": "both",
      "confidence": "template-implied",
      "note": "LNCS 单栏；llncs.cls 未加载 twocolumn，版心宽 12.2cm 即整栏宽",
      "evidence": [
        {
          "source_id": "src-eccv-2026-llncs",
          "quote": "\\setlength{\\textwidth}{12.2cm}"
        }
      ]
    },
    "text_width_mm": {
      "value": 122,
      "unit": "mm",
      "scope": "both",
      "confidence": "template-implied",
      "note": "12.2cm = 122mm 版心宽",
      "evidence": [
        {
          "source_id": "src-eccv-2026-llncs",
          "quote": "\\setlength{\\textwidth}{12.2cm}"
        }
      ]
    },
    "text_height_mm": {
      "value": 193,
      "unit": "mm",
      "scope": "both",
      "confidence": "template-implied",
      "note": "19.3cm = 193mm 版心高",
      "evidence": [
        {
          "source_id": "src-eccv-2026-llncs",
          "quote": "\\setlength{\\textheight}{19.3cm}"
        }
      ]
    },
    "margins_mm": {
      "value": {
        "top": 12,
        "bottom": 12,
        "left": 12,
        "right": 12
      },
      "unit": "mm",
      "scope": "submission",
      "confidence": "template-implied",
      "note": "ECCV 2026 送审版 geometry 裁剪：paperwidth 146mm、paperheight 217mm、top/left=12mm、版心 122x193mm → 四边等效 12mm",
      "evidence": [
        {
          "source_id": "src-eccv-2026-eccvsty",
          "quote": "\\RequirePackage[width=122mm,left=12mm,paperwidth=146mm,height=193mm,top=12mm,paperheight=217mm]{geometry}"
        }
      ]
    },
    "body_font_size_pt": {
      "value": 10,
      "unit": "pt",
      "scope": "both",
      "confidence": "template-implied",
      "note": "llncs 基于 article 10pt 基础类（未传字号选项），正文即 10pt；LNCS 说明中标题字号体系（一级 12pt/二级 10pt）亦按此",
      "evidence": [
        {
          "source_id": "src-eccv-2026-llncs",
          "quote": "\\LoadClass[twoside]{article}"
        }
      ]
    },
    "body_font_family": {
      "value": "CMR (Computer Modern Roman)",
      "unit": null,
      "scope": "both",
      "confidence": "official",
      "note": "LaTeX 模板用 CMR，不得改用 Times（改用字体可能被视为规避页数）",
      "evidence": [
        {
          "source_id": "src-eccv-2026-maintex",
          "quote": "Springer's templates for \\LaTeX{} are based on CMR, and the XML templates for Word are based on Times."
        }
      ]
    },
    "title_format": {
      "value": "14pt bold, centered",
      "unit": null,
      "scope": "both",
      "confidence": "official",
      "note": "标题 14 point 粗体、居中",
      "evidence": [
        {
          "source_id": "src-eccv-lncs-instructions",
          "quote": "Title (centered) Lecture Notes 14 point, bold"
        }
      ]
    },
    "section_numbering": {
      "value": "arabic (only first two heading levels numbered)",
      "unit": null,
      "scope": "both",
      "confidence": "official",
      "note": "仅一、二级标题编号；标题左对齐",
      "evidence": [
        {
          "source_id": "src-eccv-lncs-instructions",
          "quote": "Only the first two levels of section headings should be numbered, as shown in Table 1."
        }
      ]
    },
    "bib_style": {
      "value": "splncs04",
      "unit": null,
      "scope": "both",
      "confidence": "template-implied",
      "note": "官方 sty 指定 \\bibliographystyle{splncs04}",
      "evidence": [
        {
          "source_id": "src-eccv-2026-eccvsty",
          "quote": "\\bibliographystyle{splncs04}"
        }
      ]
    },
    "anonymity": {
      "value": "double-blind",
      "unit": null,
      "scope": "submission",
      "confidence": "official",
      "note": "双盲评审；不得在正文/补充材料泄露身份或放置可识别链接",
      "evidence": [
        {
          "source_id": "src-eccv-2026-submissionpolicies",
          "quote": "ECCV reviewing is double blind, in that authors do not know the names of the area chairs or reviewers for their papers, and the area chairs/reviewers cannot, beyond a reasonable doubt, infer the names of the authors from the submission and the additional material."
        }
      ]
    },
    "submission_system": {
      "value": "OpenReview",
      "unit": null,
      "scope": "submission",
      "confidence": "official",
      "note": "ECCV 2026 使用 OpenReview（2022/2024 用 CMT）",
      "evidence": [
        {
          "source_id": "src-eccv-2026-submissionpolicies",
          "quote": "ECCV 2026 will be using OpenReview to manage submissions."
        }
      ]
    },
    "supplementary_policy": {
      "value": "optional supplementary (videos, proofs, extra figures/tables/analyses); main paper must stand alone",
      "unit": null,
      "scope": "submission",
      "confidence": "official",
      "note": "补充材料可选、独立提交；正文须自洽",
      "evidence": [
        {
          "source_id": "src-eccv-2026-submissionpolicies",
          "quote": "By the supplementary material deadline (Mar 12, 2026, at 11:00 PM CET), the authors may optionally submit additional material that was ready at the time of paper submission but could not be included due to constraints of format or space."
        }
      ]
    }
  },
  "recommended": {
    "table_caption_position": {
      "value": "above",
      "unit": null,
      "scope": "both",
      "confidence": "official",
      "note": "表题在表格上方（Springer LNCS 规范）",
      "evidence": [

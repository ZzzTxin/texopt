  "texopt_requirement_map": {
    "note": "ICLR 单栏；font_pt 取官方正文 10pt；margin_mm 取等效单边边距 38.1mm（左右 1.5in；上下 1in 更小，用 margin_min_mm 约束时注意左右远大于上下）",
    "requirement_fields": {
      "page_limit": 10,
      "font_pt": 10,
      "margin_mm": 38.1,
      "float_spec": "tbp",
      "overwide_fig_threshold_mm": 139.7
    },
    "unsupported_constraints": [
      {
        "key": "paper_size",
        "value": "letter",
        "why": "Requirement 无纸张尺寸字段"
      },
      {
        "key": "columns",
        "value": 1,
        "why": "Requirement 无栏数字段；ICLR 单栏，仅用于校验"
      },
      {
        "key": "margins_mm",
        "value": {
          "top": 25.4,
          "bottom": 25.4,
          "left": 38.1,
          "right": 38.1
        },
        "why": "Requirement.margin_mm 是单一等效值，无法表达非对称边距"
      },
      {
        "key": "page_limit_content",
        "value": 10,
        "why": "page_limit 为总页数语义；ICLR 的 10 页仅指主文本（参考文献/附录另计），且还有 6 页下限"
      },
      {
        "key": "supplementary_policy",
        "value": "ethics/repro statement <=1 page",
        "why": "texopt 不生成/校验伦理与可复现性声明"
      }
    ],
    "recommended_field_suggestions": [
      {
        "field": "columns",
        "type": "int",
        "example": 1,
        "rationale": "校验编译结果栏数是否与官方单栏模板一致"
      },
      {
        "field": "page_limit_scope",
        "type": "str",
        "example": "content_only",
        "rationale": "区分主文本页数与总页数"
      },
      {
        "field": "page_limit_min",
        "type": "int",
        "example": 6,
        "rationale": "ICLR 2025 有 6 页下限，单值 page_limit 表达不了区间"
      },
      {
        "field": "asymmetric_margins",
        "type": "obj",
        "example": {
          "left": 38.1,
          "right": 38.1,
          "top": 25.4,
          "bottom": 25.4
        },
        "rationale": "ICLR 左右边距(1.5in)远大于上下(1in)"
      }
    ]
  },

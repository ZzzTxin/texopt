  "texopt_requirement_map": {
    "note": "font_pt 取 acmart sigconf 正文 9pt；margin_mm 取等效单边 19.05mm；page_limit 取正文 8 页（总 12 页见 unsupported）",
    "requirement_fields": {
      "page_limit": 8,
      "font_pt": 9,
      "margin_mm": 19.05,
      "eq_fleqn_allowed": true,
      "float_spec": "tbp",
      "microtype": true,
      "overwide_fig_threshold_mm": 177.8,
      "verbose": false
    },
    "unsupported_constraints": [
      {
        "key": "paper_size",
        "value": "letter",
        "why": "Requirement 无纸张尺寸字段"
      },
      {
        "key": "columns",
        "value": 2,
        "why": "Requirement 无栏数字段；sigconf 固定双栏"
      },
      {
        "key": "page_limit_total",
        "value": 12,
        "why": "投稿总页数 12 含参考文献/附录，与 page_limit 语义冲突，需支持计数范围"
      },
      {
        "key": "appendix_counted",
        "value": true,
        "why": "texopt 无附录计数概念"
      },
      {
        "key": "anonymity",
        "value": "double-blind",
        "why": "texopt 不检测匿名化"
      }
    ],
    "recommended_field_suggestions": [
      {
        "field": "columns",
        "type": "int",
        "example": 2,
        "rationale": "校验编译结果栏数是否与官方模板一致"
      },
      {
        "field": "page_limit_scope",
        "type": "str",
        "example": "content_only",
        "rationale": "区分 8 页正文与 12 页总上限"
      },
      {
        "field": "asymmetric_margins",
        "type": "obj",
        "example": {
          "left": 19.05,
          "right": 19.05,
          "top": 20.11,
          "bottom": 25.75
        },
        "rationale": "ACM 模板上下边距不等"
      }
    ]
  },

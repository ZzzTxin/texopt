  "texopt_requirement_map": {
    "note": "font_pt 取官方正文 11pt；margin_mm 取四边统一的 2.5cm=25mm；overwide_fig_threshold_mm 取版心总宽 160mm",
    "requirement_fields": {
      "page_limit": 8,
      "font_pt": 11,
      "margin_mm": 25.0,
      "float_spec": "tbp",
      "overwide_fig_threshold_mm": 160.0
    },
    "unsupported_constraints": [
      {
        "key": "paper_size",
        "value": "a4",
        "why": "Requirement 无纸张尺寸字段；texopt 不更换纸张"
      },
      {
        "key": "columns",
        "value": 2,
        "why": "Requirement 无栏数字段；仅用于校验/迁移判断"
      },
      {
        "key": "page_limit_content",
        "value": 8,
        "why": "page_limit 语义为总页数，ACL 的 8 页仅指正文（参考文献/附录另计，不限页）"
      },
      {
        "key": "references_counted",
        "value": false,
        "why": "texopt 无法表达「参考文献不计页」的计数范围"
      },
      {
        "key": "checklist_required",
        "value": true,
        "why": "texopt 不生成/校验 checklist"
      }
    ],
    "recommended_field_suggestions": [
      {
        "field": "columns",
        "type": "int",
        "example": 2,
        "rationale": "校验编译结果栏数是否与官方模板一致"
      },
      {
        "field": "page_limit_scope",
        "type": "str",
        "example": "content_only",
        "rationale": "区分正文页与总页，否则会把参考文献算进去导致过度压缩"
      },
      {
        "field": "caption_position_policy",
        "type": "obj",
        "example": {
          "figure": "below",
          "table": "below"
        },
        "rationale": "图/表题位于下方是官方硬规定，可作 A 项检查"
      }
    ]
  },

  "texopt_requirement_map": {
    "note": "font_pt 取 acmart sigconf 正文 9pt；margin_mm 取等效单边最小值 19.05mm（左右 inner/outer），上下边距未压缩时可更大；page_limit 取 content pages 8",
    "requirement_fields": {
      "page_limit": 8,
      "font_pt": 9,
      "margin_mm": 19.05,
      "eq_fleqn_allowed": true,
      "float_spec": "tbp",
      "microtype": true,
      "overwide_fig_threshold_mm": 177.8,
      "verbose": false
    },
    "unsupported_constraints": [
      {
        "key": "paper_size",
        "value": "letter",
        "why": "Requirement 无纸张尺寸字段；texopt 不更换纸张"
      },
      {
        "key": "columns",
        "value": 2,
        "why": "Requirement 无栏数字段；sigconf 固定双栏"
      },
      {
        "key": "margins_mm",
        "value": {
          "top": 20.11,
          "bottom": 25.75,
          "left": 19.05,
          "right": 19.05
        },
        "why": "Requirement.margin_mm 为单一等效值，无法表达非对称边距"
      },
      {
        "key": "page_limit_content",
        "value": 8,
        "why": "page_limit 语义为总页数，KDD 的 8 页仅指 content pages（参考文献/附录另计），需支持计数范围"
      },
      {
        "key": "anonymity",
        "value": "double-blind",
        "why": "texopt 不检测匿名化"
      },
      {
        "key": "page_limit_total",
        "value": 12,
        "why": "录用版 12 页含 3 页参考文献/附录，与 page_limit 语义冲突"
      }
    ],
    "recommended_field_suggestions": [
      {
        "field": "columns",
        "type": "int",
        "example": 2,
        "rationale": "校验编译结果栏数是否与官方模板一致"
      },
      {
        "field": "page_limit_scope",
        "type": "str",
        "example": "content_only",
        "rationale": "区分正文页与总页数，避免把参考文献算入导致过度压缩"
      },
      {
        "field": "asymmetric_margins",
        "type": "obj",
        "example": {
          "left": 19.05,
          "right": 19.05,
          "top": 20.11,
          "bottom": 25.75
        },
        "rationale": "ACM 模板上下边距不等，单一值会失真"
      }
    ]
  },

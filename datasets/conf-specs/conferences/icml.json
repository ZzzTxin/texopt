  "texopt_requirement_map": {
    "note": "font_pt 取官方正文 10pt；margin_mm 取等效单边最小边距 22.225mm（左右 0.875in；上下 1in 更大，压缩时以下限约束，避免压到不合规）",
    "requirement_fields": {
      "page_limit": 9,
      "font_pt": 10,
      "margin_mm": 22.225,
      "float_spec": "tbp",
      "overwide_fig_threshold_mm": 171.45
    },
    "unsupported_constraints": [
      {
        "key": "paper_size",
        "value": "letter",
        "why": "Requirement 无纸张尺寸字段；texopt 不更换纸张"
      },
      {
        "key": "columns",
        "value": 2,
        "why": "Requirement 无栏数字段；ICML 为双栏，仅用于校验/迁移判断"
      },
      {
        "key": "margins_mm",
        "value": {
          "top": 25.4,
          "bottom": 25.4,
          "left": 22.225,
          "right": 22.225
        },
        "why": "Requirement.margin_mm 是单一等效值，无法表达非对称边距"
      },
      {
        "key": "page_limit_content",
        "value": 8,
        "why": "page_limit 语义为总页数；ICML 的 8 页仅指 content pages（附录/参考文献另计），需 requirements 支持计数范围"
      },
      {
        "key": "appendix_allowed",
        "value": true,
        "why": "texopt 不生成/校验附录结构"
      }
    ],
    "recommended_field_suggestions": [
      {
        "field": "columns",
        "type": "int",
        "example": 2,
        "rationale": "校验编译结果栏数是否与官方双栏模板一致"
      },
      {
        "field": "page_limit_scope",
        "type": "str",
        "example": "content_only",
        "rationale": "区分正文页数与总页数，避免把不限页的参考文献/附录算进去导致过度压缩"
      },
      {
        "field": "camera_ready_extra_pages",
        "type": "int",
        "example": 1,
        "rationale": "录用版比投稿版多 1 页，优化目标不同"
      }
    ]
  },
